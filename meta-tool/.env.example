# Paid tier keys use api.deepl.com
DEEPL_API_KEY=

# Google AI Studio (Gemini) API key
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API key  (fallback rewriter)
# https://console.groq.com/keys
GROQ_API_KEY=
