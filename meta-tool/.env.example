# DeepL API key
# Free tier keys end with ':fx'  →  uses api-free.deepl.com automatically
# Paid tier keys use api.deepl.com
DEEPL_API_KEY=

# OpenAI API key (primary rewriter — gpt-4o-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio (Gemini) API key — fallback rewriter
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API key — last-resort rewriter
# https://console.groq.com/keys
GROQ_API_KEY=
